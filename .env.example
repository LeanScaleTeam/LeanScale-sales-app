# Supabase Configuration
# Get these from: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Slack Webhook
# Create at: https://api.slack.com/apps > Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# n8n Webhooks (optional - for AI-powered automation)
# General webhook for intake form processing
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/xxxxx
# SOW content generation webhook (AI-generated executive summaries, scope descriptions)
N8N_SOW_WEBHOOK_URL=https://your-n8n-instance.com/webhook/yyyyy

# Teamwork API
# Site: leanscale3.teamwork.com
# Credentials: Basic Auth (API token as username, 'x' as password)
TEAMWORK_SITE_URL=https://leanscale3.teamwork.com
TEAMWORK_API_TOKEN=your-teamwork-api-token

# Base Domain (for subdomain routing)
NEXT_PUBLIC_BASE_DOMAIN=leanscale.team

# HubSpot OAuth (for Diagnostic v2 CRM metadata download)
# App ID: 26734965 — register redirect URIs in HubSpot Developer Portal
HUBSPOT_CLIENT_ID=your-hubspot-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/hubspot/callback

# Salesforce OAuth (for Diagnostic v2 CRM metadata download)
# Connected App hosted in LeanScale's Salesforce org
SALESFORCE_CLIENT_ID=your-salesforce-connected-app-client-id
SALESFORCE_CLIENT_SECRET=your-salesforce-connected-app-client-secret
SALESFORCE_REDIRECT_URI=http://localhost:3000/api/salesforce/callback

# OpenRouter API (for transcript analysis via Claude)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# Claude Code Routine API (for Vasco data sync)
# Token: created in Claude.ai > Routines > API Token
# Trigger ID: from the Vasco Data Sync routine
# Endpoint: POST https://api.anthropic.com/v1/claude_code/routines/{id}/fire
CLAUDE_TRIGGER_API_TOKEN=your-claude-routine-api-token
CLAUDE_VASCO_TRIGGER_ID=your-vasco-routine-trigger-id
